# 41. `.gitignore`

```gitignore
# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environment
.venv/
venv/
env/

# Streamlit
.streamlit/

# Database
*.db
*.sqlite
*.sqlite3

# Uploaded files
uploads/*

# ML model cache
models_cache/*

# Environment
.env

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Pytest
.pytest_cache/

# Temporary
*.tmp
*.log